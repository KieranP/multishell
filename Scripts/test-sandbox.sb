(version 1)
; Writes only to the build tree and the temporary directories, so a test
; reaching the account's own files fails; see Docs/develop/tests.md.
(allow default)
(deny file-write*)
(allow file-write*
  (subpath (string-append (param "REPO") "/.build"))
  (subpath (string-append (param "HOME") "/Library/Caches/org.swift.swiftpm"))
  (subpath (string-append (param "HOME") "/Library/org.swift.swiftpm"))
  (subpath "/private/tmp")
  (subpath "/private/var/folders")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/dtracehelper")
  (literal "/dev/ptmx")
  (regex #"^/dev/tty")
  (regex #"^/dev/fd/"))
