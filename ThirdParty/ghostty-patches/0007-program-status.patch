+
+    /// Answer the OSC 7501 support query, and pass a report on to the
+    /// apprt. A program that gets no answer reports nothing.
+    fn programStatus(
+        self: *StreamHandler,
+        command: terminal.osc.Command.ProgramStatus,
+    ) void {
+        switch (command) {
+            .query => |terminator| switch (terminator) {
+                inline else => |t| self.messageWriter(.{
+                    .write_stable = "\x1b]7501;" ++
+                        terminal.osc.program_status.query_reply ++
+                        comptime t.string(),
+                }),
+            },
+            .report => |report| {
+                const body = apprt.surface.Message.WriteReq.init(
+                    self.alloc,
+                    report.data,
+                ) catch |err| {
+                    log.warn("error passing on a program status err={}", .{err});
+                    return;
+                };
+                self.surfaceMessageWriter(.{ .program_status = .{
+                    .state = report.state,
+                    .body = body,
+                } });
+            },
+        }
+    }
 };
 
