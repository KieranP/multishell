+/// One OSC 7501 report, its title and msg decoded. A null id is the
+/// program's own record, any other a child record of it.
+pub const ProgramStatus = struct {
+    state: State,
+    kind: Kind,
+    /// -1 where the report carries no percentage the state allows.
+    progress: i8,
+    id: ?[:0]const u8,
+    app: ?[:0]const u8,
+    title: ?[:0]const u8,
+    msg: ?[:0]const u8,
+
+    /// Sync with: ghostty_action_program_status_state_e
+    pub const State = enum(c_int) {
+        idle,
+        working,
+        done,
+        blocked,
+        @"error",
+        clear,
+
+        pub fn init(state: terminal.osc.Command.ProgramStatus.State) State {
+            return switch (state) {
+                inline else => |tag| @field(State, @tagName(tag)),
+            };
+        }
+
+        test "ghostty.h ProgramStatus.State" {
+            try lib.checkGhosttyHEnum(State, "GHOSTTY_PROGRAM_STATUS_");
+        }
+    };
+
+    /// Sync with: ghostty_action_program_status_kind_e
+    pub const Kind = enum(c_int) {
+        none,
+        permission,
+        question,
+        auth,
+
+        pub fn init(kind: ?terminal.osc.Command.ProgramStatus.Kind) Kind {
+            return switch (kind orelse return .none) {
+                inline else => |tag| @field(Kind, @tagName(tag)),
+            };
+        }
+
+        test "ghostty.h ProgramStatus.Kind" {
+            try lib.checkGhosttyHEnum(Kind, "GHOSTTY_PROGRAM_STATUS_KIND_");
+        }
+    };
+
+    // Sync with: ghostty_action_program_status_s
+    pub const C = extern struct {
+        state: State,
+        kind: Kind,
+        progress: i8,
+        id: ?[*:0]const u8,
+        app: ?[*:0]const u8,
+        title: ?[*:0]const u8,
+        msg: ?[*:0]const u8,
+    };
+
+    pub fn cval(self: ProgramStatus) C {
+        return .{
+            .state = self.state,
+            .kind = self.kind,
+            .progress = self.progress,
+            .id = if (self.id) |v| v.ptr else null,
+            .app = if (self.app) |v| v.ptr else null,
+            .title = if (self.title) |v| v.ptr else null,
+            .msg = if (self.msg) |v| v.ptr else null,
+        };
+    }
+};
