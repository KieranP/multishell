+/// Hand an OSC 7501 report to the apprt with its title and msg decoded.
+/// The strings live on this stack frame, so they last only for the call.
+fn programStatus(
+    self: *Surface,
+    state: terminal.osc.Command.ProgramStatus.State,
+    body: []const u8,
+) void {
+    const program_status = terminal.osc.program_status;
+    const report: program_status.Report = .{ .state = state, .data = body };
+
+    var id: [program_status.max_id_bytes:0]u8 = undefined;
+    var app: [program_status.max_app_bytes:0]u8 = undefined;
+    var title: [program_status.max_title_bytes:0]u8 = undefined;
+    var msg: [program_status.max_msg_bytes:0]u8 = undefined;
+    _ = self.rt_app.performAction(
+        .{ .surface = self },
+        .program_status,
+        .{
+            .state = .init(state),
+            .kind = .init(report.readOption(.kind)),
+            // The parser reads only 0 to 100, so it fits an i8.
+            .progress = if (report.readOption(.progress)) |v| @intCast(v) else -1,
+            .id = copyProgramStatusValue(id.len, &id, report.readOption(.id)),
+            .app = copyProgramStatusValue(app.len, &app, report.readOption(.app)),
+            .title = decodeProgramStatusText(report, .title, title.len, &title),
+            .msg = decodeProgramStatusText(report, .msg, msg.len, &msg),
+        },
+    ) catch |err| {
+        log.warn("apprt failed to report program status err={}", .{err});
+    };
+}
+
+/// The parser already held every value to its limit, so it always fits.
+fn copyProgramStatusValue(
+    comptime capacity: usize,
+    buf: *[capacity:0]u8,
+    value: ?[]const u8,
+) ?[:0]const u8 {
+    const v = value orelse return null;
+    @memcpy(buf[0..v.len], v);
+    buf[v.len] = 0;
+    return buf[0..v.len :0];
+}
+
+fn decodeProgramStatusText(
+    report: terminal.osc.program_status.Report,
+    comptime option: terminal.osc.program_status.Option,
+    comptime capacity: usize,
+    buf: *[capacity:0]u8,
+) ?[:0]const u8 {
+    var writer: std.Io.Writer = .fixed(buf[0..capacity]);
+    report.writeText(option, &writer) catch return null;
+    const text = writer.buffered();
+    if (text.len == 0) return null;
+    buf[text.len] = 0;
+    return buf[0..text.len :0];
+}
