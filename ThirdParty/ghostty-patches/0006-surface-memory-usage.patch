diff --git a/src/apprt/embedded.zig b/src/apprt/embedded.zig
index b90366ac7..bacaffad6 100644
--- a/src/apprt/embedded.zig
+++ b/src/apprt/embedded.zig
@@ -1987,6 +1987,26 @@ pub const CAPI = struct {
         return .fromSlice(copy);
     }
 
+    /// Returns the bytes of physical memory the surface's terminal holds:
+    /// both screens' pages, scrollback included, and their Kitty images.
+    /// The renderer's GPU buffers and font atlas are not counted. This
+    /// visits every page under the terminal lock, so call it periodically.
+    export fn ghostty_surface_memory_usage(surface: *Surface) u64 {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lockUncancelable(global.io());
+        defer core_surface.renderer_state.mutex.unlock(global.io());
+
+        const screens = &core_surface.renderer_state.terminal.screens;
+        return screenResidentBytes(screens.get(.primary)) +|
+            screenResidentBytes(screens.get(.alternate));
+    }
+
+    /// The alternate screen is created on first use, so it may be null.
+    fn screenResidentBytes(screen: ?*const terminal.Screen) u64 {
+        const usage = (screen orelse return 0).memoryUsage();
+        return @as(u64, usage.pages.resident_bytes) +| usage.image_bytes;
+    }
+
