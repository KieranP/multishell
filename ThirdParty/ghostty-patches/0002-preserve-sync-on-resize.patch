Keep DEC 2026 synchronized output on across a resize.

A program clears and repaints inside one synchronized-output transaction, and
the renderer holds its last frame until the program ends it. Terminal.resize()
at the pin ends the transaction itself, so a resize between the clear and the
repaint shows the empty grid and the whole pane blinks: libghostty-spm measured
291 of 1201 frames blank during a resize, 0 with this. The mode now ends when
the program ends it, or at termio's one-second watchdog (sync_reset_ms).
libghostty-vt's stream handler reports the hold's end only when the mode is
off after the resize, and the tests asserting the old behaviour follow.

From libghostty-spm's Patches/ghostty/0014-preserve-sync-on-resize.sh (MIT, 2026 @Lakr233),
cut as a `git diff` against the ThirdParty/ghostty pin.

diff --git a/src/terminal/Terminal.zig b/src/terminal/Terminal.zig
index 78f2b43e9..8a61cc30c 100644
--- a/src/terminal/Terminal.zig
+++ b/src/terminal/Terminal.zig
@@ -4080,7 +4080,9 @@ pub fn resize(
         ) catch std.math.maxInt(u32);
     }
 
-    self.modes.set(.synchronized_output, false);
+    // libghostty-spm: synchronized output stays as the program left it. A
+    // resize must not present the half-drawn frame the mode is hiding; the
+    // termio watchdog still ends a transaction nobody finishes.
 
     // If our cols/rows didn't change, skip grid work but still apply pixels.
     if (self.cols == opts.cols and self.rows == opts.rows) return;
@@ -4350,7 +4352,7 @@ test "Terminal setScrollback only affects primary screen" {
     try testing.expectEqual(alternate, t.screens.active);
 }
 
-test "Terminal: resize resets synchronized output" {
+test "Terminal: resize preserves synchronized output" {
     const alloc = testing.allocator;
     const io_impl = testing.io;
     var t = try init(io_impl, alloc, .{ .cols = 10, .rows = 5 });
@@ -4358,7 +4360,7 @@ test "Terminal: resize resets synchronized output" {
 
     t.modes.set(.synchronized_output, true);
     try t.resize(alloc, .{ .cols = 10, .rows = 5 });
-    try testing.expect(!t.modes.get(.synchronized_output));
+    try testing.expect(t.modes.get(.synchronized_output));
 }
 
 test "Terminal: resize rejects zero dimensions before mutation" {
@@ -4524,7 +4526,7 @@ test "Terminal: resize failure paths preserve consistent state" {
             try testing.expectEqual(@as(size.CellCountInt, 4), t.rows);
             try testing.expectEqual(@as(u32, 4617), t.width_px);
             try testing.expectEqual(@as(u32, 72), t.height_px);
-            try testing.expect(!t.modes.get(.synchronized_output));
+            try testing.expect(t.modes.get(.synchronized_output));
             try testing.expect(t.flags.dirty.clear);
             try testing.expectEqual(@as(size.CellCountInt, 513), primary.pages.cols);
             try testing.expectEqual(@as(size.CellCountInt, 4), primary.pages.rows);
