Add a `custom-shaders` build option, and build without them.

Ghostty links glslang and SPIRV-Cross unconditionally, for custom shaders the
app never runs. Off, neither is in libghostty: with the inspector off too, the
archive here went from 132 MB to 20 MB, and the notices stay short. A user's
`custom-shader` line then does nothing.

From libghostty-spm's Patches/ghostty/0006-disable-custom-shaders.sh (MIT, 2026 @Lakr233),
cut as a `git diff` against the ThirdParty/ghostty pin.

diff --git a/src/build/Config.zig b/src/build/Config.zig
index 71fa4d289..346790026 100644
--- a/src/build/Config.zig
+++ b/src/build/Config.zig
@@ -31,6 +31,7 @@ font_backend: FontBackend = .freetype,
 x11: bool = false,
 wayland: bool = false,
 sentry: bool = true,
+custom_shaders: bool = true, // LIBGHOSTTY_SPM_TRIM_PATCH
 simd: bool = true,
 i18n: bool = true,
 wasm_shared: bool = true,
@@ -235,6 +236,12 @@ pub fn init(b: *std.Build, appVersion: []const u8, libVersion: []const u8) !Conf
         }
     };
 
+    config.custom_shaders = b.option(
+        bool,
+        "custom-shaders",
+        "Build with custom shader (glslang/spirv-cross) support.",
+    ) orelse true;
+
     config.simd = b.option(
         bool,
         "simd",
@@ -664,6 +671,7 @@ pub fn addOptions(self: *const Config, step: *std.Build.Step.Options) !void {
     step.addOption(bool, "x11", self.x11);
     step.addOption(bool, "wayland", self.wayland);
     step.addOption(bool, "sentry", self.sentry);
+    step.addOption(bool, "custom_shaders", self.custom_shaders);
     step.addOption(bool, "simd", self.simd);
     step.addOption(bool, "i18n", self.i18n);
     step.addOption(ApprtRuntime, "app_runtime", self.app_runtime);
